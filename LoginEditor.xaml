<Window x:Class="KalugaCampus.LoginEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Единый вход МГТУ · ЛКЭОС" Width="448" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Icon="campus.ico" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource FieldFill}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border x:Name="Frame" CornerRadius="8" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".78"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Background="{DynamicResource Surface}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="44" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                <DockPanel Margin="14,0,6,0">
                    <Button DockPanel.Dock="Right" Width="32" Height="30" Padding="0" BorderBrush="Transparent"
                            AutomationProperties.Name="Закрыть" ToolTip="Закрыть" Click="OnClose"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M1,1 L11,11 M11,1 L1,11" Stroke="{DynamicResource Ink}" StrokeThickness="1.5"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="campus.ico" Width="20" Height="20"/>
                        <TextBlock Text="ЛКЭОС" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button IsCancel="True" Content="Отмена" Margin="0,0,8,0"/>
                    <Button IsDefault="True" Content="Сохранить" Background="{DynamicResource Primary}" BorderBrush="{DynamicResource Primary}"
                            Foreground="White" Click="OnSave"/>
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="24,19,24,20">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Единый вход МГТУ"/>
                    <TextBlock x:Name="ProfileLabel" Margin="0,3,0,19" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                    <Label Content="_Логин" Target="{Binding ElementName=LoginBox}"/>
                    <TextBox x:Name="LoginBox" Style="{StaticResource Field}" Margin="0,6,0,14" MaxLength="256"
                             CaretBrush="{DynamicResource Ink}"/>
                    <Label Content="_Пароль" Target="{Binding ElementName=SecretBox}"/>
                    <PasswordBox x:Name="SecretBox" Style="{StaticResource Field}" Margin="0,6,0,0" MaxLength="1280"
                                 CaretBrush="{DynamicResource Ink}"/>
                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Muted}" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                               Text="Один логин для ЭОС и ЛКС. Пароль хранится в Диспетчере учётных данных Windows."/>
                    <TextBlock x:Name="ErrorMessage" Foreground="{DynamicResource ErrorInk}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,10,0,0"/>
                                <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
