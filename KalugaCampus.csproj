<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <Product>ЛКЭОС</Product>
    <AssemblyTitle>ЛКЭОС</AssemblyTitle>
    <Description>Личный кабинет ЭОС Калужского филиала МГТУ</Description>
    <ApplicationIcon>campus.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <EmbeddedResource Include="Ui\*" />
    <Resource Include="campus.ico" />
  </ItemGroup>

</Project>
